[MAIN]
# The modules live at the repo root and import each other as top-level modules
# (matching how pipeline.py is run). Put the root on sys.path so pylint resolves
# them the same way pytest does via `pythonpath = .` in pytest.ini.
init-hook = 'import sys; sys.path.insert(0, ".")'

[DESIGN]
# store.record_file maps 1:1 to its table columns (including transcribe/summarize
# provenance); FileResult mirrors the same fields as a plain data holder.
max-args = 10
max-attributes = 10
# pipeline.run_pipeline is one linear state machine (paused / listing failure /
# only-filter miss / empty / per-file loop / cancelled / finished) where each
# branch needs its own Telegram notification; splitting it up would scatter
# that flow across helpers without making any single piece simpler.
max-statements = 55
