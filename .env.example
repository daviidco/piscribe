RCLONE_REMOTE=gdrive
PENDING_FOLDER=pendings
PROCESSED_FOLDER=processed
QWEN_MODEL=qwen3:1.7b
GROQ_API_KEY=your_groq_api_key

# Optional — only set to override the defaults (all under ~/whisper.cpp/):
#   DB_PATH=~/whisper.cpp/piscribe.db
#   RUN_LOG_DIR=~/whisper.cpp/runs
#   LOCK_PATH=~/whisper.cpp/piscribe.lock
#   PAUSE_FLAG=~/whisper.cpp/piscribe.paused
#   DEADMAN_HOURS=5

# Optional — Groq-first transcription/summary (blank GROQ_API_KEY = disabled,
# every run uses local whisper.cpp / Ollama). Only set these to override:
#   GROQ_MODEL=qwen/qwen3.8-27b
#   GROQ_WHISPER_MODEL=whisper-large-v3
#   GROQ_TIMEOUT_SECONDS=20
#   GROQ_AUDIO_TIMEOUT_SECONDS=60
#   GROQ_MAX_AUDIO_MB=24
#   GROQ_MAX_COMPLETION_TOKENS=8192
#   GROQ_CHUNK_CHARS=6000
#   GROQ_CHUNK_MAX_COMPLETION_TOKENS=500
